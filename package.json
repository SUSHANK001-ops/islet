{
  "name": "islet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Islet - a focus and study companion that lives in a pill at the top of your screen.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-character": "node scripts/validate-character.mjs",
    "character-preview": "node scripts/character-preview.mjs",
    "size-report": "node scripts/size-report.mjs",
    "check-no-dev": "node scripts/check-no-dev.mjs",
    "release": "tauri build && node scripts/check-no-dev.mjs && node scripts/size-report.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.0.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@preact/signals": "^1.3.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
