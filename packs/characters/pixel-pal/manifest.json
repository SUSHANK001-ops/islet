{
  "schemaVersion": 1,
  "id": "pixel-pal",
  "name": "Pip",
  "version": "1.2.0",
  "author": "Islet",
  "license": "CC0-1.0",

  "sheet": {
    "file": "sheet.png",
    "frameWidth": 48,
    "frameHeight": 48,
    "columns": 8,
    "scale": 2,
    "pixelArt": false
  },

  "states": {
    "idle":        { "frames": [0, 1, 2, 3],     "fps": 6,  "loop": true },
    "working":     { "frames": [8, 9, 10, 11],   "fps": 8,  "loop": true },
    "celebrating": { "frames": [16, 17, 18, 19], "fps": 12, "loop": false },
    "sleeping":    { "frames": [24, 25],         "fps": 2,  "loop": true },
    "sad":         { "frames": [32, 33, 34],     "fps": 4,  "loop": true },
    "curious":     { "frames": [40, 41, 42],     "fps": 6,  "loop": true }
  },

  "moods": {
    "happy": "idle",
    "tired": "sleeping",
    "bored": "curious",
    "proud": "celebrating"
  },

  "stages": [
    { "id": "spark", "minFocusMinutes": 0, "sheet": "sheet.png" }
  ],

  "personality": { "energy": 0.7, "chatty": 0.5, "lazy": 0.3 },

  "outfits": []
}
