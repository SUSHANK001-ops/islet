{
  "productName": "Islet",
  "version": "0.2.0",
  "identifier": "dev.islet.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Islet",
        "width": 360,
        "height": 240,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/characters/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["../packs/**/*"],
    "publisher": "Islet",
    "copyright": "© Islet",
    "category": "Productivity",
    "shortDescription": "A focus and study companion in a pill.",
    "longDescription": "Islet is a focus and study companion with a living character that sits in a small pill at the top of your screen. Focus timer, tasks, notes, media controls, a safe app launcher, and progress tracking - all local, no account, no telemetry.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
